{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgermesh.dev/schemas/events/event-envelope.v1.json",
  "title": "LedgerMesh Event Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "transaction_id",
    "correlation_id",
    "causation_id",
    "aggregate_type",
    "aggregate_id",
    "aggregate_version",
    "workflow_step",
    "fencing_token",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
    "transaction_id": {"type": "string", "format": "uuid"},
    "correlation_id": {"type": "string", "format": "uuid"},
    "causation_id": {"type": ["string", "null"], "format": "uuid"},
    "aggregate_type": {"type": "string", "minLength": 1},
    "aggregate_id": {"type": "string", "minLength": 1},
    "aggregate_version": {"type": ["integer", "null"], "minimum": 0},
    "workflow_step": {"type": ["integer", "null"], "minimum": 0},
    "fencing_token": {"type": ["integer", "null"], "minimum": 0},
    "occurred_at": {"type": "string", "format": "date-time", "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "payload": {"type": "object"}
  }
}
