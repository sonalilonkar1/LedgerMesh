# Local validation of the staging stack (LM-048). NOT for the hosted VM.
#
#   cp infra/staging/.env.local.example infra/staging/.env.local   # gitignored
#   make staging-local-up
#
# On the VM, infra/staging/render-env.sh writes the same keys from Secret
# Manager and instance metadata into /etc/ledgermesh/staging.env (mode 0600).
# These placeholder passwords are only for a throwaway local stack.

# Caddy site address and TLS mode. `internal` uses Caddy's local CA.
LEDGERMESH_SITE_ADDRESS=localhost
LEDGERMESH_TLS=internal

# One password per service database (letters, digits and . _ ~ - only, at
# least 16 characters; they are embedded in DATABASE_URL).
COORDINATOR_DB_PASSWORD=local-only-change-me-coordinator
WALLET_DB_PASSWORD=local-only-change-me-wallet
CATALOG_DB_PASSWORD=local-only-change-me-catalog
AUDIT_LEDGER_DB_PASSWORD=local-only-change-me-audit-ledger
