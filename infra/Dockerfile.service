# Production-capable image for one LedgerMesh service (LM-047).
#
# The same Dockerfile builds every service; SERVICE selects which one starts by
# default. Docker Compose (LM-003) builds it too and overrides the command.
#
#   docker build -f infra/Dockerfile.service --build-arg SERVICE=wallet \
#     --build-arg PORT=8001 -t ledgermesh-wallet:local .
#
# Any module in the image can also be run by overriding the command, e.g.
#   docker run ledgermesh-wallet:local python -m services.wallet.app.saga_worker

# Base images are pinned by digest so the same commit always builds from the
# same bytes. The tag stays alongside for readability; bump both together.

# ---- builder: resolve the locked dependency graph into a virtualenv ----------
FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df AS builder

COPY --from=ghcr.io/astral-sh/uv:0.13.6@sha256:af22a52f5eafef3d78e551599d405c02df61919d18028f0cea8eda93bc9986d0 /uv /bin/

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

COPY pyproject.toml uv.lock ./
# The messaging library is a local path dependency. --no-editable installs it
# into the virtualenv, so the runtime image does not need its source tree.
COPY libs/messaging ./libs/messaging
RUN uv sync --locked --no-dev --no-install-project --no-editable

# ---- runtime: only the virtualenv and the service code -----------------------
FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df AS runtime

ARG SERVICE=coordinator
ARG PORT=8000
ARG SERVICE_NAME=${SERVICE}
ARG LEDGERMESH_REVISION=unknown
ARG LEDGERMESH_VERSION=unknown

# A fixed, unprivileged UID/GID; nothing in the image runs as root.
RUN groupadd --gid 10001 ledgermesh \
    && useradd --uid 10001 --gid 10001 --no-create-home \
       --shell /usr/sbin/nologin ledgermesh

WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SERVICE=${SERVICE} \
    SERVICE_NAME=${SERVICE_NAME} \
    PORT=${PORT} \
    LEDGERMESH_REVISION=${LEDGERMESH_REVISION} \
    LEDGERMESH_VERSION=${LEDGERMESH_VERSION} \
    RUN_MIGRATIONS=false

COPY --from=builder --chown=root:root /app/.venv /app/.venv
COPY --chown=root:root services ./services
COPY --chown=root:root --chmod=0755 infra/docker/start-service.sh /app/start-service.sh

RUN apt-get update \
    && apt-get install --yes --no-install-recommends --only-upgrade \
        libpam-modules \
        libpam-modules-bin \
        libpam-runtime \
        libpam0g \
        libzstd1 \
    && rm -rf /var/lib/apt/lists/*

USER 10001:10001
EXPOSE ${PORT}

HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=6 \
    CMD python -c "import os, urllib.request; urllib.request.urlopen(f'http://127.0.0.1:{os.environ[\"PORT\"]}/health', timeout=2)"

CMD ["/app/start-service.sh"]
