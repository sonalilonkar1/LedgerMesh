# Optional host-port overrides. Compose uses these defaults when no .env file exists.
COORDINATOR_PORT=8000
WALLET_PORT=8001
CATALOG_PORT=8002
AUDIT_LEDGER_PORT=8003
IDENTITY_PORT=8005
KAFKA_PORT=29092
COORDINATOR_DB_PORT=54321
WALLET_DB_PORT=54322
CATALOG_DB_PORT=54323
AUDIT_LEDGER_DB_PORT=54324
IDENTITY_DB_PORT=54325
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Normalized addresses that get the operator role locally (LM-052).
IDENTITY_OPERATOR_EMAILS=operator@example.com

# Local-development credentials only. Do not reuse outside the local Compose stack.
POSTGRES_PASSWORD=ledgermesh_dev

